# Copy this file to .env and fill in your key.
# Get a key at https://console.groq.com -- check that dashboard for the current model catalog,
# since Groq periodically retires/renames hosted models.

# Environment: dev | test | prod  (prod requires GROQ_API_KEY)
APP_ENV=dev

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

RETURN_WINDOW_DAYS=14
AUTO_APPROVE_REFUND_CEILING_EUR=100

DATABASE_URL=sqlite:///./ecommerce.db
CHECKPOINT_DB_PATH=./checkpoints.sqlite

FRONTEND_ORIGIN=http://localhost:5173

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=ecommerce
